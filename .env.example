# Paid Interior AI (Fal.ai) — server-only key (never shown to customers)
# Get a key at https://fal.ai/dashboard/keys
# Set here OR via /ai-admin (owner PIN). Customers use access codes instead.
FAL_KEY=

# Require paid subscriber access code before any Fal spend (default: true)
# AI_REQUIRE_SUBSCRIPTION=true

# Owner PIN for /ai-admin (issue codes, set Fal key). Change in production.
# AI_ADMIN_PIN=2468

# Optional model overrides
# Create / room+product install (default: fal-ai/flux-2-pro/edit)
# FAL_VISUALISE_MODEL=fal-ai/flux-2-pro/edit
# Chat follow-up edits (default: fal-ai/flux-pro/kontext)
# FAL_REFINE_MODEL=fal-ai/flux-pro/kontext
# Live carcass (defaults to FAL_VISUALISE_MODEL)
# FAL_CARCASS_MODEL=fal-ai/flux-2-pro/edit
# Sales chatbot LLM via fal-ai/any-llm (default: google/gemini-2.5-flash)
# FAL_CHAT_MODEL=google/gemini-2.5-flash
