# Prefer Google Gemini for chat + room / carcass visualise
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional models (defaults are fine)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# Optional Fal fallback (not used when Gemini key is set)
# FAL_KEY=

# Paid unlock codes — leave false to use Gemini without subscriber codes
AI_REQUIRE_SUBSCRIPTION=false

# Owner PIN for /ai-admin (paste Gemini key). Default 2468.
# AI_ADMIN_PIN=2468
