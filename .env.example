# Prefer Fal.ai for visualise + chat (card billing — no Google AI Studio payment)
# Get a key: https://fal.ai/dashboard/keys  (add a little credit for the event)
FAL_KEY=

# Claude for Business Teams (/teams) — Sales, WhatsApp, Instagram Reels
# Get a key: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=

# Optional: Google Gemini (only if Fal is not set) — not used by Business Teams
# GEMINI_API_KEY=

# Event demo: allow AI without subscriber unlock codes
AI_REQUIRE_SUBSCRIPTION=false

# Owner PIN for /ai-admin (issue codes / paste Fal or Claude key). Default 2468.
# AI_ADMIN_PIN=2468
