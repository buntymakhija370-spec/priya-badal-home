# Google Gemini AI (cheap Flash Image + Flash chat) — server-only key
# Get a key at https://aistudio.google.com/apikey
# Set here OR paste via /ai-admin (owner PIN). Customers use access codes instead.
GEMINI_API_KEY=

# Require paid subscriber access code before any Gemini spend (default: true)
# AI_REQUIRE_SUBSCRIPTION=true

# Owner PIN for /ai-admin (issue codes, set Gemini key). Change in production.
# AI_ADMIN_PIN=2468

# Optional model overrides (cheap defaults below)
# Image edit / visualise / carcass (default: gemini-2.5-flash-image = Nano Banana)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Sales chatbot (default: gemini-2.5-flash)
# GEMINI_CHAT_MODEL=gemini-2.5-flash
